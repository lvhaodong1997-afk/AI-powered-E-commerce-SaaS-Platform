            "value": "{{tenantId}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin-api/tk/automation/v1/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin-api",
            "tk",
            "automation",
            "v1",
            "tasks",
