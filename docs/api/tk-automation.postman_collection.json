        },
        "description": "选择真实可用音色，填写对应 ttsProvider，并将 voiceCode 或 voiceProfileId 其中之一写入环境；未使用项留空。MiMo必须使用voiceProfileId。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP successful\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
