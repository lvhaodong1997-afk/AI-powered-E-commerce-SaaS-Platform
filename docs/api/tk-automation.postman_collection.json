            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "06 查询我的上传 BGM",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "tenant-id",
            "value": "{{tenantId}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin-api/tk/automation/v1/bgms",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin-api",
            "tk",
            "automation",
            "v1",
            "bgms"
          ]
        },
        "description": "从当前账号自己上传的同人群曲目中选择，将真实ID写入bgmAssetId，不自动跨人群补选。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP successful\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const result = pm.response.json();",
              "pm.test(\"Business code is 0\", () => pm.expect(result.code, result.msg).to.eql(0));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "07 创建生成任务（使用积分，默认禁用）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "tenant-id",
            "value": "{{tenantId}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin-api/tk/automation/v1/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin-api",
            "tk",
            "automation",
            "v1",
            "tasks"
          ]
        },
        "description": "可能产生积分冻结/消耗。本集合不支持自动创建重试。响应丢失先按标题与时间核对网页生成记录；不可盲重发。首次填真实资源ID、完整正文、音色，然后将allowPaidCreate改为true。每次发送前自动恢复false。创建成功捕获taskId。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"libraryId\": {{libraryId}},\n  \"title\": \"{{title}}\",\n  \"scriptText\": \"{{scriptText}}\",\n  \"ttsProvider\": \"{{ttsProvider}}\",\n  \"voiceCode\": \"{{voiceCode}}\",\n  \"bgmAssetId\": {{bgmAssetId}},\n  \"bgmVolume\": 0.4,\n  \"translationEnabled\": false,\n  \"targetRegion\": \"CN\",\n  \"durationMode\": \"FOLLOW_NARRATION\",\n  \"width\": 1080,\n  \"height\": 1920,\n  \"fps\": 30,\n  \"subtitleEnabled\": true,\n  \"subtitleFontSize\": \"extra_large\",\n  \"subtitleStyle\": \"classic_white\",\n  \"subtitlePositionMode\": \"smart_safe\",\n  \"subtitleKeywordEnabled\": true,\n  \"subtitleKaraokeEnabled\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function stop(message) { pm.execution.skipRequest(); throw new Error(message); }",
              "if (pm.environment.get(\"allowPaidCreate\") !== \"true\") stop(\"默认禁止收费创建。核对参数后将当前本机环境 allowPaidCreate 设为 true，仅允许一次。\");",
              "pm.environment.set(\"allowPaidCreate\", \"false\");",
              "if (pm.environment.get(\"taskId\")) stop(\"已有taskId：请先查询/核对该任务。确需新建时先清空taskId，再重新开启一次创建。\");",
              "const read = (key) => String(pm.environment.get(key) || \"\").trim();",
              "const positiveId = (key) => { const value = read(key); if (!/^[1-9][0-9]*$/.test(value)) stop(key + \"必须为真实正整数ID\"); return value; };",
              "const library = positiveId(\"libraryId\"); const bgm = positiveId(\"bgmAssetId\");",
              "const profile = read(\"voiceProfileId\"); const code = read(\"voiceCode\");",
              "if (Boolean(profile) === Boolean(code)) stop(\"voiceProfileId与voiceCode必须二选一\");",
              "const provider = read(\"ttsProvider\");",
              "if (![\"MINIMAX\", \"DASHSCOPE\", \"MIMO\"].includes(provider)) stop(\"ttsProvider无效\");",
              "if (provider === \"MIMO\" && !profile) stop(\"MiMo必须使用voiceProfileId\");",
              "const script = String(pm.environment.get(\"scriptText\") || \"\");",
              "if (!script.trim() || script.length > 3000) stop(\"scriptText必须为1–3000字符的完整口播正文\");",
              "const title = String(pm.environment.get(\"title\") || \"\");",
              "if (title.length > 128) stop(\"title最长128字符\");",
              "const payload = {libraryId: \"__LIBRARY_NUMERIC__\", title, scriptText: script, ttsProvider: provider,",
              "  bgmAssetId: \"__BGM_NUMERIC__\", bgmVolume: 0.4, translationEnabled: false, targetRegion: \"CN\",",
              "  durationMode: \"FOLLOW_NARRATION\", width: 1080, height: 1920, fps: 30, subtitleEnabled: true,",
              "  subtitleFontSize: \"extra_large\", subtitleStyle: \"classic_white\", subtitlePositionMode: \"smart_safe\",",
              "  subtitleKeywordEnabled: true, subtitleKaraokeEnabled: true};",
              "if (profile) { positiveId(\"voiceProfileId\"); payload.voiceProfileId = \"__PROFILE_NUMERIC__\"; } else { payload.voiceCode = code; }",
              "// 保留int64 ID原始十进制文本，避免JS Number精度丢失；正文由JSON.stringify正确转义。",
              "let raw = JSON.stringify(payload, null, 2).replace(/\"libraryId\": \"__LIBRARY_NUMERIC__\"/, \"\\\"libraryId\\\": \" + library)",
              "  .replace(/\"bgmAssetId\": \"__BGM_NUMERIC__\"/, \"\\\"bgmAssetId\\\": \" + bgm);",
              "if (profile) raw = raw.replace(/\"voiceProfileId\": \"__PROFILE_NUMERIC__\"/, \"\\\"voiceProfileId\\\": \" + profile);",
              "pm.request.body.update(raw);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP successful\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const result = pm.response.json();",
              "pm.test(\"Business code is 0\", () => pm.expect(result.code, result.msg).to.eql(0));",
              "if (result.code === 0 && result.data != null) {",
              "  pm.environment.set(\"taskId\", String(result.data.taskId));",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "08 查询任务进度",
      "request": {
        "method": "GET",
        "header": [
          {
