        "description": "手动或按3–5秒间隔查询，设置整体等待上限。completed=true才成功；failed=true读取failCode/failReason并停止。检查subtitleKaraokeStatus/Reason。集合不自动无限轮询。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP successful\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const result = pm.response.json();",
              "pm.test(\"Business code is 0\", () => pm.expect(result.code, result.msg).to.eql(0));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "09 获取成片下载地址",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "tenant-id",
            "value": "{{tenantId}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin-api/tk/automation/v1/tasks/{{taskId}}/download?fileName={{fileNameEncoded}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin-api",
            "tk",
            "automation",
            "v1",
            "tasks",
            "{{taskId}}",
            "download"
          ],
          "query": [
            {
              "key": "fileName",
              "value": "{{fileNameEncoded}}"
            }
          ]
        },
        "description": "返回JSON，不返回MP4文件流。成功后访问downloadUrl按fileName保存；不要向存储链接发送平台Token。链接失效重新获取。"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"fileNameEncoded\", encodeURIComponent(pm.environment.get(\"fileName\") || \"output.mp4\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP successful\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const result = pm.response.json();",
              "pm.test(\"Business code is 0\", () => pm.expect(result.code, result.msg).to.eql(0));",
              "if (result.code === 0 && result.data != null) {",
              "  pm.environment.set(\"downloadUrl\", result.data.downloadUrl);",
              "}"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
