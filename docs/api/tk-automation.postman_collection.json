      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP successful\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const result = pm.response.json();",
              "pm.test(\"Business code is 0\", () => pm.expect(result.code, result.msg).to.eql(0));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "04 查询素材库",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "tenant-id",
            "value": "{{tenantId}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin-api/tk/automation/v1/material-libraries?name={{libraryNameEncoded}}&pageNo={{pageNo}}&pageSize={{pageSize}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin-api",
            "tk",
            "automation",
            "v1",
            "material-libraries"
          ],
          "query": [
            {
              "key": "name",
              "value": "{{libraryNameEncoded}}"
            },
            {
              "key": "pageNo",
              "value": "{{pageNo}}"
            },
            {
              "key": "pageSize",
              "value": "{{pageSize}}"
            }
          ]
        },
        "description": "默认每页10条，最大200。遍历 list/total，明确选定资源后将真实 ID 写入 libraryId，同名时不要直接用第一项。"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"libraryNameEncoded\", encodeURIComponent(pm.environment.get(\"libraryName\") || \"\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP successful\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const result = pm.response.json();",
              "pm.test(\"Business code is 0\", () => pm.expect(result.code, result.msg).to.eql(0));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "05 查询音色",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "tenant-id",
            "value": "{{tenantId}}",
            "type": "text"
          }
        ],
        "url": {
