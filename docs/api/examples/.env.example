# 此文件仅列出变量，脚本不会自动加载 .env。请在自己的服务端环境中设置。
BASE_URL=https://clipforgestudio.fnn.net.cn
TENANT_ID=REPLACE_WITH_YOUR_TENANT_ID
TK_ACCESS_TOKEN=
TK_REFRESH_TOKEN=

# 可选：未提供 accessToken / refreshToken 时才使用账号登录。
# 必须使用真实登录账号，不是昵称。开启验证码时须先完成原验证码流程。
TK_USERNAME=
TK_PASSWORD=
TK_CAPTCHA_VERIFICATION=

# 可选：默认 ~/.clipforge/session.json。不同租户、环境使用不同文件。
# 登录或刷新后的 Token 会写入这里。务必限制文件权限，不要提交到 Git。
TK_TOKEN_FILE=
