[Unit]
Description=TK Auto Mix Production Yudao Backend
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=linux
WorkingDirectory=/data/Tk/current/app
ExecStartPre=/usr/bin/test -f /data/Tk/current/tools/reference-video-download/douyin_tiktok_bilibili_tool.py
ExecStartPre=/usr/bin/test -d /data/Tk/current/tools/reference-video-download/Douyin_TikTok_Download_API
ExecStartPre=/usr/bin/test -x /data/Tk/current/tools/reference-video-download/.venv/bin/python
ExecStartPre=/usr/bin/test -f /data/Tk/current/tools/subtitle/asr_faster_whisper.py
ExecStartPre=/usr/bin/test -x /data/Tk/current/.venv-asr/bin/python
ExecStartPre=/usr/bin/test -d /data/Tk/current/models/faster-whisper
ExecStart=/usr/bin/java -Xms512m -Xmx1024m -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai -jar /data/Tk/current/app/yudao-server.jar --spring.config.additional-location=file:/data/Tk/current/app/application-prod.yaml --spring.profiles.active=prod
SuccessExitStatus=143
Restart=always
RestartSec=10
TimeoutStopSec=60
LimitNOFILE=65535
SyslogIdentifier=tk-yudao-prod
StandardOutput=append:/data/Tk/current/app/systemd.out.log
StandardError=append:/data/Tk/current/app/systemd.err.log

[Install]
WantedBy=multi-user.target
